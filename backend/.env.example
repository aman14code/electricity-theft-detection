# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/theft_detection

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-key
JWT_EXPIRES_IN=7d

# ─── ML Microservice ────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
